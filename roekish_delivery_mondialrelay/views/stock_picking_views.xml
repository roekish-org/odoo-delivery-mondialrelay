<odoo>
    <record id="view_picking_form_mondialrelay" model="ir.ui.view">
        <field name="name">stock.picking.form.mondialrelay</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="mondialrelay_is_pickup" invisible="1" />
                <div
                    class="o_row"
                    colspan="2"
                    invisible="not mondialrelay_is_pickup"
                >
                    <button
                        name="action_mondialrelay_choose_pickup_point"
                        type="object"
                        string="Choose Point Relais"
                        icon="fa-map-marker"
                        class="btn-link"
                    />
                    <field name="mondialrelay_pickup_point_name" readonly="1" />
                    <field
                        name="mondialrelay_pickup_point_code"
                        readonly="1"
                        nolabel="1"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
