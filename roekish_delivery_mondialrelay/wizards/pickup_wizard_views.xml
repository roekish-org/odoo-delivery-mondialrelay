<odoo>
    <record id="view_mondialrelay_pickup_wizard_form" model="ir.ui.view">
        <field name="name">delivery.mondialrelay.pickup.wizard.form</field>
        <field name="model">delivery.mondialrelay.pickup.wizard</field>
        <field name="arch" type="xml">
            <form string="Points Relais">
                <field name="picking_id" invisible="1" />
                <group>
                    <group>
                        <field name="zip" />
                        <field name="city" />
                    </group>
                    <group>
                        <field name="country_id" />
                        <field name="weight" />
                    </group>
                </group>
                <button
                    name="action_search"
                    type="object"
                    string="Search"
                    class="btn-primary"
                    icon="fa-search"
                />
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="false" edit="false">
                        <field name="name" />
                        <field name="street" />
                        <field name="zip" />
                        <field name="city" />
                        <field name="country_code" />
                        <field name="distance" />
                        <button
                            name="action_select"
                            type="object"
                            string="Select"
                            class="btn-link"
                            icon="fa-check"
                        />
                    </list>
                </field>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
